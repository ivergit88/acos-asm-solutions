     1                                  ; Складываем чётные числа от 0 до N включительно.
     2                                  ; Это for (i = 0; i <= N; i += 2), в теле которого sum += i.
     3                                  ; При N=10 получаем 0+2+4+6+8+10 = 30.
     4                                  %ifndef N
     5                                      %define N 10
     6                                  %endif
     7                                  ; Эта проверка выполняется при сборке, а не во время запуска.
     8                                  %if N < 0 || N > 65534
     9                                      %error "N must be in 0..65534"
    10                                  %endif
    11                                  bits 64
    12                                  global _start
    13                                  section .text
    14                                  _start:
    15 00000000 BB0A000000                  mov ebx, N             ; верхняя граница
    16 00000005 B900000000                  mov ecx, 0             ; накопленная сумма
    17 0000000A B800000000                  mov eax, 0             ; текущее чётное число, начинаем с нуля
    18                                  check:
    19 0000000F 39D8                        cmp eax, ebx           ; сравнить текущее число с N
    20 00000011 7F07                        jg done                ; выходим только при i > N, поэтому равенство входит в цикл
    21 00000013 01C1                        add ecx, eax           ; прибавить текущее число к сумме
    22 00000015 83C002                      add eax, 2             ; перейти к следующему чётному
    23 00000018 EBF5                        jmp check              ; снова проверить границу, не обнуляя счётчик
    24                                  done:
    25 0000001A 89CF                        mov edi, ecx           ; передать сумму как код завершения
    26 0000001C B83C000000                  mov eax, 60            ; системный вызов exit
    27 00000021 0F05                        syscall
    28                                  ; echo $? показывает младшие 8 бит ответа. Для N=10 все 30 видны целиком.
    29                                  section .note.GNU-stack noalloc noexec nowrite progbits
