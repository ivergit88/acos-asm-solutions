     1                                  ; Читаем число 0..99 и печатаем его удвоенное значение: 21 -> Result: 42.
     2                                  ; На входе по условию корректные цифры и перевод строки.
     3                                  bits 64
     4                                  global _start
     5
     6                                  section .rodata            ; постоянные данные, которые не будем менять
     7 00000000 526573756C743A20        prefix: db "Result: "      ; 8 символов, включая пробел после двоеточия
     8
     9                                  section .bss               ; память под буферы; при запуске она заполнена нулями
    10 00000000 <res 20h>               inbuf:  resb 32            ; сюда read положит введённые символы
    11 00000020 ??????????              numbuf: resb 5             ; здесь подготовим текст результата и перевод строки
    12
    13                                  section .text
    14                                  _start:
    15                                      ; Сначала задаём аргументы read. Само чтение начнётся только на syscall.
    16 00000000 31C0                        xor eax, eax           ; обнулить EAX: номер read равен 0
    17 00000002 31FF                        xor edi, edi           ; 0 — стандартный ввод
    18 00000004 488D35(00000000)            lea rsi, [rel inbuf]   ; RSI получает адрес буфера, а не его содержимое
    19 0000000B BA20000000                  mov edx, 32            ; можно прочитать не больше 32 байт
    20 00000010 0F05                        syscall                ; для ввода 21 буфер получит байты 32 31 0A
    21
    22                                      ; Собираем число по цифрам: накопленное * 10 + следующая цифра.
    23 00000012 488D35(00000000)            lea rsi, [rel inbuf]   ; вернуться к началу введённой строки
    24 00000019 31C0                        xor eax, eax           ; пока разобранное число равно нулю
    25                                  next:
    26 0000001B 0FB60E                      movzx ecx, byte [rsi]  ; прочитать один символ из памяти и расширить его нулями
    27 0000001E 83F90A                      cmp ecx, 10            ; 10 (0A) — перевод строки LF
    28 00000021 741C                        je parsed              ; дошли до конца строки — разбор закончен
    29 00000023 83F90D                      cmp ecx, 13            ; также останавливаемся на CR
    30 00000026 7417                        je parsed
    31 00000028 83F930                      cmp ecx, '0'           ; символ должен быть в диапазоне '0'..'9'
    32 0000002B 7212                        jb parsed
    33 0000002D 83F939                      cmp ecx, '9'
    34 00000030 770D                        ja parsed
    35 00000032 83E930                      sub ecx, '0'           ; из кода символа получить цифру: '2' - '0' = 2
    36 00000035 6BC00A                      imul eax, eax, 10      ; освободить следующий десятичный разряд
    37 00000038 01C8                        add eax, ecx           ; прибавить цифру: сначала 2, потом 2*10+1 = 21
    38 0000003A 48FFC6                      inc rsi                ; сдвинуть адрес на следующий символ
    39 0000003D EBDC                        jmp next
    40                                  parsed:
    41 0000003F 01C0                        add eax, eax           ; удвоить само число: 21 + 21 = 42
    42
    43                                      ; Остатки от деления дают цифры с конца, поэтому пишем справа налево.
    44 00000041 488D3D(24000000)            lea rdi, [rel numbuf + 4]
    45 00000048 BB0A000000                  mov ebx, 10            ; делитель для получения десятичных цифр
    46 0000004D 31C9                        xor ecx, ecx           ; счётчик записанных цифр
    47                                  digits:
    48 0000004F 31D2                        xor edx, edx           ; перед КАЖДЫМ делением очистить старшую половину EDX:EAX
    49 00000051 F7F3                        div ebx                ; EAX — частное, EDX — остаток: для 42 это 4 и 2
    50 00000053 80C230                      add dl, '0'            ; превратить остаток в символ цифры
    51 00000056 48FFCF                      dec rdi                ; выделить место на один символ левее
    52 00000059 8817                        mov byte [rdi], dl     ; записать цифру в память
    53 0000005B FFC1                        inc ecx                ; посчитать записанную цифру
    54 0000005D 85C0                        test eax, eax          ; осталось ли что-то в частном?
    55 0000005F 75EE                        jnz digits             ; если осталось, получить следующую цифру
    56                                      ; Цикл проходит хотя бы раз: число 0 тоже превращается в символ '0'.
    57 00000061 C6040F0A                    mov byte [rdi + rcx], 10 ; после цифр поставить LF
    58 00000065 4989F8                      mov r8, rdi            ; сохранить адрес первой цифры
    59 00000068 4C8D4901                    lea r9, [rcx + 1]      ; сохранить длину: цифры плюс LF
    60
    61                                      ; syscall меняет RCX и R11, поэтому длину заранее сохранили в R9.
    62 0000006C B801000000                  mov eax, 1             ; номер write
    63 00000071 BF01000000                  mov edi, 1             ; 1 — стандартный вывод
    64 00000076 488D35(00000000)            lea rsi, [rel prefix]  ; адрес строки Result:
    65 0000007D BA08000000                  mov edx, 8             ; вывести 8 байт префикса
    66 00000082 0F05                        syscall
    67 00000084 B801000000                  mov eax, 1             ; второй write печатает само число
    68 00000089 BF01000000                  mov edi, 1
    69 0000008E 4C89C6                      mov rsi, r8             ; адрес первой цифры
    70 00000091 4C89CA                      mov rdx, r9             ; количество цифр вместе с LF
    71 00000094 0F05                        syscall
    72 00000096 B83C000000                  mov eax, 60            ; номер exit
    73 0000009B 31FF                        xor edi, edi           ; код 0 — успешное завершение, ответ уже напечатан
    74 0000009D 0F05                        syscall
    75
    76                                  section .note.GNU-stack noalloc noexec nowrite progbits
