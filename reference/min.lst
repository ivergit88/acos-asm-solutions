     1                                  ; Ищем минимум трёх целых чисел. Для 7, 3 и 2 ответ — 2.
     2                                  ; A, B и C задаются при сборке, вводить их с клавиатуры здесь не нужно.
     3                                  %ifndef A
     4                                      %define A 7
     5                                  %endif
     6                                  %ifndef B
     7                                      %define B 3
     8                                  %endif
     9                                  %ifndef C
    10                                      %define C 2
    11                                  %endif
    12                                  bits 64                    ; программа работает в режиме x86-64
    13                                  global _start              ; отсюда начнётся выполнение
    14                                  section .text              ; дальше идут инструкции
    15                                  _start:
    16                                      ; В MOV слева — куда записать, справа — откуда взять значение.
    17 00000000 B807000000                  mov eax, A             ; считаем первое число текущим минимумом
    18 00000005 BB03000000                  mov ebx, B
    19 0000000A B902000000                  mov ecx, C
    20
    21 0000000F 39D8                        cmp eax, ebx           ; сравнить текущий минимум со вторым числом
    22 00000011 7E02                        jle check_c            ; если он уже <= B, оставляем его и проверяем C
    23 00000013 89D8                        mov eax, ebx           ; иначе второе число меньше — выбираем его
    24                                  check_c:
    25 00000015 39C8                        cmp eax, ecx           ; теперь сравнить выбранный минимум с третьим числом
    26 00000017 7E02                        jle done               ; если он <= C, ответ уже найден
    27 00000019 89C8                        mov eax, ecx           ; иначе минимум — третье число
    28                                  done:
    29 0000001B 89C7                        mov edi, eax           ; сохранить ответ до того, как перезапишем EAX
    30 0000001D B83C000000                  mov eax, 60            ; 60 — номер системного вызова exit в Linux x86-64
    31 00000022 0F05                        syscall                ; завершиться; ответ виден через echo $?
    32                                  ; Служебная отметка: выполнять код на стеке не нужно.
    33                                  section .note.GNU-stack noalloc noexec nowrite progbits
